	// PRIMEIRA COISA QUE É EXIBIDA NA TELA

	public function exibirTela(Request $request)
	{

		$porPagina = 25;
		$paginaAtual = (int) $request->get('page', 1);

		$retorno = $this->DadosdoProcesso($paginaAtual, $porPagina);


		$leituracampos = $retorno['dados'];
		$totalRegistros = $retorno['total'];

		$msgErro = 'ERRO: Falta dado';

		$dadosTratados = array_map(function ($item) use ($msgErro) {
			return [
				"20378||"               => $item["20378||"] ?? $msgErro,
				"17591||"               => $item["17591||"] ?? $msgErro,
				"20836||"               => $item["20836||"] ?? 0,
				"16107||"               => $item["16107||"] ?? $msgErro,
				"17714|| @displayName"  => $item["17714|| @displayName"] ?? $msgErro,
				"17681||"               => $item["17681||"] ?? $msgErro,
				"17684||"               => $item["17684||"] ?? $msgErro,
				"17684||nome"           => $item["17684||nome"] ?? $msgErro,
				"20554||"               => $item["20554||"] ?? $msgErro,
				"20554||nome"           => $item["20554||nome"] ?? $msgErro,
				"18156||"               => $item["18156||"] ?? $msgErro
			];
		}, $leituracampos);
		// SALVA NO CACHE
		foreach ($dadosTratados as $processo) {
			$idProcesso = $processo['20378||'];
			if ($idProcesso !== $msgErro) {
				// 1 hora = 3600 segundos
				cache()->put('dossie_proc_' . $idProcesso, $processo, 3600);
			}
		}

		$resultado = new LengthAwarePaginator(
			$dadosTratados,
			$totalRegistros,
			$porPagina,
			$paginaAtual,
			[
				'path' => $request->url(),
				'query' => $request->query()
			]
		);

		return view('dossie.default', compact('resultado'));
	}

	//BOTÃO GERAR DOSSIÊ DA TELA
	public function btnGerarDossie(Request $request)
	{
		set_time_limit(300);

		$processoId = $request->input('processo_id');

		// Inicia o array de rastreamento do log
		$rastreioLog = [
			'processo_id' => $processoId,
			'status'      => 'iniciado',
			'subsidio_id' => null,
			'teses'       => [],
			'etapas'      => []
		];

		try {
			$bancotese = new TeseFormatada();
			$obArcherRest = new ArcherRest();
			$CriarWordxDossie = new WordxDossieController();

			// 1) PEGA OS DADOS PROCESSADOS PELO RELATÓRIO E ARMAZENADOS NO CACHE
			$dadosDoProcesso = cache()->get('dossie_proc_' . $processoId);
			if (!$dadosDoProcesso) {
				$rastreioLog['status'] = 'falha_sessao';
				$this->gerenciarLogDossie("Falha: Sessão expirou no cache.", $rastreioLog);
				return back()->with('error', 'Sessão expirou. Por favor, atualize a página da tabela e tente novamente.');
			}

			$jsonGerarDocumento = json_encode($dadosDoProcesso);
			$idPdf = $dadosDoProcesso['17684||'] ?? null;
			$idDocx = $dadosDoProcesso['20554||'] ?? null;
			$idDoSubsidio = $dadosDoProcesso['18156||'] ?? null;

			$rastreioLog['subsidio_id'] = $idDoSubsidio;
			$rastreioLog['etapas'][] = 'dados_carregados';

			// 2) USA A API DO LAZARO PARA EXTRAIR O TEXTO E PEGAR AS TESES
			$textoPeticaoInicial = $this->extrair_texto($idPdf);
			$extrairTeses = $this->analisarTeses($textoPeticaoInicial);
			$rastreioLog['teses'] = $extrairTeses;
			$rastreioLog['etapas'][] = 'ocr_teses_analisadas';

			// 3) PEGA O NUMERO DAS TESES E BUSCA NO BANCO O TEXTO
			$teseslistabanco = $bancotese->numeroTesesBanco($extrairTeses);

			// 3.1) SINTESE FÁTICA (CAUSA DE PEDIR E OS PEDIDOS)
			$sintesefatica = $this->sinteseFatica($textoPeticaoInicial);
			$rastreioLog['etapas'][] = 'sintese_fatica_gerada';

			// 4) PEGA O ARQUIVO DO ARTÉRIA, EXTRAI, E CRIA O DOCX
			$arquivodcx = $this->getSubsidioCliente($idDocx, $idDoSubsidio);
			$jsontextosubsidio = $this->extrairArquivo($arquivodcx, $idDoSubsidio);
			$paragrafoconclusao = $this->obterParagrafosConclusao($extrairTeses);

			$criararquivo = $CriarWordxDossie->criarWordx($idDocx, $jsontextosubsidio, $teseslistabanco, $jsonGerarDocumento, $idDoSubsidio, $sintesefatica, $paragrafoconclusao);
			$rastreioLog['etapas'][] = 'docx_criado';

			// 5) GRAVA O ARQUIVO NO AMBIENTE DE HOMOLOGAÇÃO
			$caminho_limpo = str_replace('\\', '/', $criararquivo);
			$nomearquivo = basename($caminho_limpo);
			$partes = explode('automacao_dossie/' . $idDoSubsidio . '/', $caminho_limpo);
			$caminho = 'automacao_dossie/' . $idDoSubsidio . '/' . end($partes);

			$uploadarquivo = $obArcherRest->addFile($nomearquivo, $caminho);
			$obArcherRest->updateArquivoContrato($idDoSubsidio, 28403, $uploadarquivo);
			$rastreioLog['etapas'][] = 'upload_archer_concluido';

			// 6) CRIA UM ARQUIVO DE LOG TXT NA MESMA PASTA
			$rastreioLog['status'] = 'sucesso';
			$this->gerenciarLogDossie("Dossiê gerado com sucesso.", $rastreioLog);

			// 7) APAGA TODO O CONTEÚDO DA PASTA /automacao_dossie
			$this->limparPastaDossieCompleto($caminho);

			// 8) RETORNAR OS DADOS
			return view('dossie.dossie', [
				'mensagem' => "Id Criado em " . $idDoSubsidio
			]);
		} catch (\Exception $e) {
			// Se qualquer etapa falhar, o processo será logado com o motivo exato.
			$rastreioLog['status'] = 'erro';
			$rastreioLog['mensagem_erro'] = $e->getMessage();
			$this->gerenciarLogDossie("Erro ao gerar dossiê.", $rastreioLog);

			return back()->with('error', 'Ocorreu um erro durante a geração do dossiê. Verifique os logs.');
		}
	}


	public function analisarTeses($texto)
	{
		$MapeamentoTeses = new PalavrasTeses();
		$limparTexto = function ($string) {
			$mapa = [
				'á' => 'a',
				'à' => 'a',
				'ã' => 'a',
				'â' => 'a',
				'é' => 'e',
				'ê' => 'e',
				'í' => 'i',
				'ó' => 'o',
				'ô' => 'o',
				'õ' => 'o',
				'ú' => 'u',
				'ç' => 'c',
				'Á' => 'a',
				'À' => 'a',
				'Ã' => 'a',
				'Â' => 'a',
				'É' => 'e',
				'Ê' => 'e',
				'Í' => 'i',
				'Ó' => 'o',
				'Ô' => 'o',
				'Õ' => 'o',
				'Ú' => 'u',
				'Ç' => 'c'
			];
			$string = strtr($string, $mapa);
			$string = mb_strtolower($string, 'UTF-8');
			$string = preg_replace('/[^a-z0-9]/', ' ', $string);
			$string = preg_replace('/\s+/', ' ', $string);
			return trim($string);
		};

		$textoLimpo = $limparTexto($texto);

		$mapeamentoTeses = $MapeamentoTeses->dbMapeamentoteses();
		$resultado = [];

		foreach ($mapeamentoTeses as $tese) {
			$regras = json_decode($tese->termos, true);

			$passedOr = false;
			$passedAnd = true;
			$passedNot = true;
			$orCount = 0;

			if (is_array($regras)) {
				foreach ($regras as $regra) {
					if (!is_array($regra)) {
						$tipo = 'OU';
						$palavra = $limparTexto($regra);
					} else {
						$tipo = $regra['tipo'] ?? 'OU';
						$palavra = $limparTexto($regra['termo'] ?? '');
					}

					$contem = str_contains($textoLimpo, $palavra);

					if ($tipo === 'OU') {
						$orCount++;
						if ($contem) {
							$passedOr = true;
						}
					} elseif ($tipo === 'E') {
						if (!$contem) {
							$passedAnd = false;
						}
					} elseif ($tipo === 'NAO') {
						if ($contem) {
							$passedNot = false;
						}
					}
				}
			}

			if ($orCount === 0) {
				$passedOr = true;
			}

			$encontrou = ($passedOr && $passedAnd && $passedNot);

			$resultado[$tese->nome] = [
				'status'   => $encontrou,
				'field_id' => $tese->field_id
			];
		}

		$tesesAtivas = [];

		foreach ($resultado as $chaveTese => $dadosTese) {
			if (isset($dadosTese['status']) && $dadosTese['status'] === true) {
				if (preg_match('/\[TESE-(\d+)\]/', $chaveTese, $matches)) {
					$tesesAtivas[] = (int)$matches[1];
				}
			}
		}

		// TRAVA DA PRESCRIÇÃO: Se a TESE 22 (Completa) está ativa, remove a 20 e a 21
		if (in_array(22, $tesesAtivas)) {
			$tesesAtivas = array_filter($tesesAtivas, function ($id) {
				return $id !== 20 && $id !== 21;
			});
			$tesesAtivas = array_values($tesesAtivas);
		}

		// TRAVA DE JURISDIÇÃO: Se tiver a TESE 1 (JEC), remove a TESE 3 (Vara Comum)
		if (in_array(1, $tesesAtivas)) {
			$tesesAtivas = array_filter($tesesAtivas, function ($id) {
				return $id !== 3;
			});
			$tesesAtivas = array_values($tesesAtivas);
		}

		return $tesesAtivas;
	}

	//BAIXAR O ARQUIVO BASE64
	private function getSubsidioCliente($Idarquivo, $nomeDaPasta)
	{
		$docsub = new ArcherRest;
		$respostaApi = $docsub->getPecaProd($Idarquivo);

		if (!is_array($respostaApi) || !isset($respostaApi['AttachmentBytes'])) {
			return ['erro' => $respostaApi];
		}

		$base64Data = $respostaApi['AttachmentBytes'];
		$conteudoBinario = base64_decode($base64Data);

		// Define o caminho absoluto para o diretório
		$diretorio = public_path('automacao_dossie/' . $nomeDaPasta . '/');

		// Se o diretório já existir, apaga todo o conteúdo usando a facade do Laravel
		if (File::isDirectory($diretorio)) {
			File::deleteDirectory($diretorio);
		}

		// Cria o diretório novamente com as permissões corretas
		File::makeDirectory($diretorio, 0755, true, true);

		$nomeArquivo = 'subsidio' . rand(10000, 99999) . '.docx';
		$caminhoCompleto = $diretorio . $nomeArquivo;

		$sucesso = file_put_contents($caminhoCompleto, $conteudoBinario);

		if ($sucesso !== false) {
			return [
				'sucesso'      => true,
				'mensagem'     => 'Arquivo salvo com sucesso!',
				'nome_arquivo' => $nomeArquivo,
				'caminho'      => $caminhoCompleto,
				'pasta'        => $nomeDaPasta
			];
		}

		return [
			'erro' => 'Não foi possível salvar o arquivo no servidor. Verifique as permissões da pasta.'
		];
	}

