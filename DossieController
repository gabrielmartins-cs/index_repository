	public function obterParagrafosConclusao(array $extrairTeses)
	{
		if (empty($extrairTeses)) {
			return [];
		}

		$resultados = DB::table('palavras_teses')
			->where(function ($query) use ($extrairTeses) {
				foreach ($extrairTeses as $numero) {
					$numeroLimpo = trim($numero);
					$numeroFormatado = str_pad($numeroLimpo, 2, '0', STR_PAD_LEFT);
					$termoBusca = "%TESE-{$numeroFormatado}%";

					$query->orWhere('nome', 'LIKE', $termoBusca);
				}
			})

			->get(['id', 'nome', 'paragrafo_conclusao']);

		return $resultados
			->filter(function ($item) {
				return !empty(trim($item->paragrafo_conclusao));
			})
			->pluck('paragrafo_conclusao')
			->toArray();
	}

	public function extrairArquivo($idarquivodocx, $nomedapasta)
	{
		$dadosArquivo = $idarquivodocx;

		if (!isset($dadosArquivo['sucesso']) || $dadosArquivo['sucesso'] !== true) {
			return json_encode(['sucesso' => false, 'erro' => 'Arquivo Base64 inválido.'], JSON_UNESCAPED_UNICODE);
		}

		$caminhoDocx = $dadosArquivo['caminho'];
		$pastaUploadsFisica = public_path('automacao_dossie/' . $nomedapasta . '/');
		$caminhoWebImagens = 'automacao_dossie/' . $nomedapasta . '/';

		$zip = new \ZipArchive();

		if ($zip->open($caminhoDocx) === TRUE) {
			$mapaImagens = [];

			// USAR DOMDOCUMENT
			$xmlRels = $zip->getFromName('word/_rels/document.xml.rels');
			if ($xmlRels) {
				$domRels = new \DOMDocument();
				@$domRels->loadXML($xmlRels); // O @ oculta warnings inofensivos de formatação XML
				$relNodes = $domRels->getElementsByTagName('Relationship');

				foreach ($relNodes as $relNode) {
					$idRef = $relNode->getAttribute('Id');
					$target = $relNode->getAttribute('Target');

					if ($idRef && $target) {
						$caminhoNoZip = urldecode($target);
						$caminhoNoZip = str_replace('\\', '/', $caminhoNoZip);
						$caminhoNoZip = ltrim($caminhoNoZip, '/');

						if (strpos($caminhoNoZip, 'media/') === 0) {
							$caminhoNoZip = 'word/' . $caminhoNoZip;
						}
						$mapaImagens[$idRef] = $caminhoNoZip;
					}
				}
			}

			// 2. LER COM DOMDOCUMENT E XPATH
			$xmlDocumento = $zip->getFromName('word/document.xml');
			$conteudoOrdenado = [];
			$bufferTexto = "";

			if ($xmlDocumento !== false) {
				$domDoc = new \DOMDocument();
				@$domDoc->loadXML($xmlDocumento);
				$xpath = new \DOMXPath($domDoc);

				$query = '//*[local-name()="p" or local-name()="br" or local-name()="t" or local-name()="blip" or local-name()="imagedata" or local-name()="svgBlip"]';
				$nodes = $xpath->query($query);

				if ($nodes !== false) {
					foreach ($nodes as $node) {
						$nomeTag = $node->localName;

						if ($nomeTag === 'p' || $nomeTag === 'br') {
							$bufferTexto .= "\n";
						} elseif ($nomeTag === 't') {
							$bufferTexto .= $node->nodeValue;
						} elseif (in_array($nomeTag, ['blip', 'imagedata', 'svgBlip'])) {


							$textoLimpo = trim(html_entity_decode($bufferTexto, ENT_QUOTES, 'UTF-8'));
							if ($textoLimpo !== '') {
								$conteudoOrdenado[] = [
									'tipo'  => 'texto',
									'valor' => $textoLimpo
								];
							}
							$bufferTexto = ""; // Reseta


							$rIdDaImagem = $node->getAttribute('r:embed');
							if (!$rIdDaImagem) $rIdDaImagem = $node->getAttribute('r:id');
							if (!$rIdDaImagem) $rIdDaImagem = $node->getAttribute('r:link');

							// 3. Processa a extração física da imagem
							if ($rIdDaImagem && isset($mapaImagens[$rIdDaImagem])) {
								$caminhoInternoFoto = $mapaImagens[$rIdDaImagem];
								$bytesImagem = $zip->getFromName($caminhoInternoFoto);

								if ($bytesImagem !== false) {
									$nomeOriginal = basename($caminhoInternoFoto);
									$novoNomeImagem = 'doc_' . rand(10000, 99999) . '_' . $nomeOriginal;
									$caminhoDestinoFisico = $pastaUploadsFisica . $novoNomeImagem;

									file_put_contents($caminhoDestinoFisico, $bytesImagem);

									$conteudoOrdenado[] = [
										'tipo'       => 'imagem',
										'url_render' => $caminhoWebImagens . $novoNomeImagem,
										'nome'       => $novoNomeImagem
									];
								}
							}
						}
					}
				}

				// Salva qualquer texto que tenha sobrado após a última imagem
				$textoFinalLimpo = trim(html_entity_decode($bufferTexto, ENT_QUOTES, 'UTF-8'));
				if ($textoFinalLimpo !== '') {
					$conteudoOrdenado[] = [
						'tipo'  => 'texto',
						'valor' => $textoFinalLimpo
					];
				}
			}

			$zip->close();
			$resultado = [
				'sucesso' => true,
				'blocos'  => $conteudoOrdenado
			];
		} else {
			$resultado = [
				'sucesso' => false,
				'erro'    => 'Não foi possível abrir o arquivo DOCX.'
			];
		}

		return json_encode($resultado, JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT);
	}
