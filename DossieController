			'pedido_1' => $pedidosEncontrados[0] ?? null,
			'pedido_2' => $pedidosEncontrados[1] ?? null
		];
	}


	public function gerenciarLogDossie($mensagem, array $dadosExtras = [])
	{
		$diretorio = dirname(__DIR__, 3) . '/public/automacao_dossie';

		if (!is_dir($diretorio) && !mkdir($diretorio, 0777, true)) {
			\Illuminate\Support\Facades\Log::error("ERRO FATAL: Sem permissão para criar a pasta: {$diretorio}");
			return;
		}
		clearstatcache();

		$arquivos = glob($diretorio . '/log_dossie_*.log') ?: [];
		usort($arquivos, function ($a, $b) {
			return filemtime($a) <=> filemtime($b);
		});

		$arquivoMaisNovo = end($arquivos);
		$limiteTamanho = 5 * 1024 * 1024; // 5 MB

		if ($arquivoMaisNovo && filesize($arquivoMaisNovo) < $limiteTamanho) {
			$arquivoAlvo = $arquivoMaisNovo;
		} else {
			$arquivoAlvo = $diretorio . '/log_dossie_' . date('d-m-Y_H-i-s') . '.log';
			$arquivos[] = $arquivoAlvo;
		}

		$dataHora = date('Y-m-d H:i:s');
		$extrasFormatados = empty($dadosExtras) ? '' : ' | Rastreio: ' . json_encode($dadosExtras, JSON_UNESCAPED_UNICODE);
		$linhaLog = "[{$dataHora}] {$mensagem}{$extrasFormatados}";

		@file_put_contents($arquivoAlvo, $linhaLog . PHP_EOL, FILE_APPEND);

		while (count($arquivos) > 5) {
			$arquivoParaDeletar = array_shift($arquivos);
			@unlink($arquivoParaDeletar);
		}
	}


	public function visualizarLogs()
	{
		// O public_path() aponta direto para a pasta "public" do Laravel
		$diretorio = public_path('automacao_dossie');

		// Verifica se a pasta existe antes de tentar ler
		if (!is_dir($diretorio)) {
			return response()->json(['Aviso: A pasta de logs ainda não existe. Nenhum dossiê foi gerado.']);
		}

		$arquivos = glob($diretorio . '/log_dossie_*.log') ?: [];

		usort($arquivos, function ($a, $b) {
			return filemtime($b) <=> filemtime($a);
		});

		$logs = [];

		foreach ($arquivos as $arquivo) {
			if (file_exists($arquivo)) {
				$linhas = file($arquivo, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
				$linhasInvertidas = array_reverse($linhas);
				$logs = array_merge($logs, $linhasInvertidas);
			}
		}

		return response()->json($logs);
	}

