	function sinteseFatica($textoOriginal)
	{
		// Padroniza o texto (sem acentos e em minúsculo)
		$textoSemAcento = iconv('UTF-8', 'ASCII//TRANSLIT//IGNORE', $textoOriginal);
		$texto = strtolower($textoSemAcento);

		$pedidosEncontrados = Pedido::buscarNoTexto($texto);

		return [
			'empresa'  => Empresa::buscarNoTexto($texto),
