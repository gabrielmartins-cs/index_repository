<?php

namespace App\Models;

use Illuminate\Database\Eloquent\Factories\HasFactory;
use Illuminate\Database\Eloquent\Model;
use Illuminate\Support\Facades\DB;

class TeseFormatada extends Model
{
    use HasFactory;

    protected $table = 'teses_formatadas';

    protected $fillable = [
        'numero_tese',
        'tipo',
        'conteudo',
    ];


    public static function numeroTesesBanco($extrairTeses)
    {
        $tesesFormatadas = DB::table('teses_formatadas')
            ->whereIn('numero_tese', $extrairTeses)
            ->orderBy('numero_tese')
            ->orderBy('id', 'asc')
            ->get();

        $palavras = DB::table('palavras_teses')->get(['nome', 'tipo_tese']);

        $mapaCategorias = [];
        foreach ($palavras as $palavra) {
            if (preg_match('/TESE-(\d+)/i', $palavra->nome, $matches)) {
                $num = (int)$matches[1];
                $tipoDoBanco = mb_strtoupper(trim($palavra->tipo_tese ?? ''), 'UTF-8');
                if ($tipoDoBanco === 'PRELIMINARES') {
                    $mapaCategorias[$num] = 'preliminares';
                } elseif ($tipoDoBanco === 'PREJUDICIAIS') {
                    $mapaCategorias[$num] = 'prejudiciais';
                } else {
                    $mapaCategorias[$num] = 'merito';
                }
            }
        }

        foreach ($tesesFormatadas as $tese) {
            $tese->categoria = $mapaCategorias[$tese->numero_tese] ?? 'merito';
        }

        return $tesesFormatadas;
    }
}
