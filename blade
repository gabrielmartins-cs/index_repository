    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
    <script>
        // Inicializa o arrastar e soltar (Drag and Drop) em TODOS os containers que tiverem a classe .sortable-container
        // Incluindo o formulário de cadastro novo e os modais de edição
        document.addEventListener("DOMContentLoaded", function() {
            document.querySelectorAll('.sortable-container').forEach(container => {
                new Sortable(container, {
                    animation: 150,
                    handle: '.handle',
                    ghostClass: 'bg-white'
                });
            });
        });

        // Inicia um índice bem alto para não dar conflito com os que já vem preenchidos do PHP
        let blocoIndex = 9999;

        // Função universal que adiciona bloco no container especificado pelo ID
        function adicionarBlocoTexto(containerId = 'container-blocos') {
            const container = document.getElementById(containerId);
            const html = `
            <div class="card mb-3 border-left-secondary shadow-sm bloco-dinamico" id="bloco_${blocoIndex}">
                <div class="card-body py-2">
                    <div class="row align-items-center">
                        <div class="col-md-1 text-center">
                            <i class="fas fa-grip-lines text-muted handle" style="cursor: grab; font-size: 1.5rem;" title="Arraste para reordenar"></i>
                        </div>
                        <div class="col-md-2">
                            <label class="text-xs font-weight-bold text-uppercase mb-1">Tipo</label>
                            <select name="textos[${blocoIndex}][tipo]" class="form-control custom-select">
                                <option value="normal" selected>Normal</option>
                                <option value="titulo">Título</option>
                                <option value="citacao">Citação</option>
                            </select>
                        </div>
                        <div class="col-md-8">
                            <label class="text-xs font-weight-bold text-uppercase mb-1">Conteúdo</label>
                            <textarea name="textos[${blocoIndex}][conteudo]" class="form-control" rows="3" required placeholder="Digite o texto aqui..."></textarea>
                        </div>
                        <div class="col-md-1 text-center mt-3">
                            <button type="button" class="btn btn-sm btn-danger rounded-circle shadow" onclick="removerBloco('${blocoIndex}')" title="Remover Bloco">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        `;
            container.insertAdjacentHTML('beforeend', html);
            blocoIndex++;
        }

        function adicionarBlocoImagem(containerId = 'container-blocos') {
            const container = document.getElementById(containerId);
            const html = `
            <div class="card mb-3 border-left-success shadow-sm bloco-dinamico" id="bloco_${blocoIndex}">
                <div class="card-body py-2">
                    <div class="row align-items-center">
                        <div class="col-md-1 text-center">
                            <i class="fas fa-grip-lines text-muted handle" style="cursor: grab; font-size: 1.5rem;" title="Arraste para reordenar"></i>
                        </div>
                        <div class="col-md-2">
                            <label class="text-xs font-weight-bold text-uppercase mb-1 text-success">Imagem</label>
                            <input type="hidden" name="textos[${blocoIndex}][tipo]" value="imagem">
                            <div class="h5 mt-1"><span class="badge badge-success w-100 py-2">IMAGEM</span></div>
                        </div>
                        <div class="col-md-8">
                            <label class="text-xs font-weight-bold text-uppercase mb-1">Selecione o Arquivo</label>
                            <input type="file" name="textos[${blocoIndex}][conteudo_imagem]" class="form-control-file p-2 border rounded" accept="image/*" required>
                        </div>
                        <div class="col-md-1 text-center mt-3">
                            <button type="button" class="btn btn-sm btn-danger rounded-circle shadow" onclick="removerBloco('${blocoIndex}')" title="Remover Bloco">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        `;
            container.insertAdjacentHTML('beforeend', html);
            blocoIndex++;
        }

        function removerBloco(id) {
            const bloco = document.getElementById(`bloco_${id}`);
            if (bloco) {
                bloco.style.opacity = '0';
                setTimeout(() => bloco.remove(), 200);
            }
        }
    </script>
