<script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
<script>
    // Inicializa o arrastar e soltar
    document.addEventListener("DOMContentLoaded", function() {
        document.querySelectorAll('.sortable-container').forEach(container => {
            new Sortable(container, {
                animation: 150,
                handle: '.handle',
                ghostClass: 'bg-white'
            });
        });
    });

    // Removido o 'let blocoIndex = 1;' pois causava conflito de índices com o PHP.
    // Agora usamos uma função que gera um ID único para cada bloco novo.
    function gerarIdUnico() {
        return 'novo_' + Date.now() + '_' + Math.floor(Math.random() * 1000);
    }

    function adicionarBlocoTexto(containerId) {
        const container = document.getElementById(containerId);
        const uniqueId = gerarIdUnico(); // Gera um índice seguro e exclusivo

        const html = `
        <div class="card mb-3 border-left-secondary shadow-sm bloco-dinamico" id="bloco_${uniqueId}">
            <div class="card-body py-2">
                <div class="row align-items-center">
                    <div class="col-md-1 text-center">
                        <i class="fas fa-grip-lines text-muted handle" style="cursor: grab; font-size: 1.5rem;" title="Arraste para reordenar"></i>
                    </div>
                    <div class="col-md-2">
                        <label class="text-xs font-weight-bold text-uppercase mb-1">Tipo</label>
                        <select name="textos[${uniqueId}][tipo]" class="form-control custom-select">
                            <option value="normal" selected>Normal</option>
                            <option value="citacao">Citação</option>
                        </select>
                    </div>
                    <div class="col-md-8">
                        <label class="text-xs font-weight-bold text-uppercase mb-1">Conteúdo</label>
                        <textarea name="textos[${uniqueId}][conteudo]" class="form-control" rows="3" required placeholder="Digite o texto aqui..."></textarea>
                    </div>
                    <div class="col-md-1 d-flex justify-content-center align-items-center mt-3">
                        <button type="button" class="btn btn-danger rounded-circle shadow" style="width: 36px; height: 36px; padding: 0; display: inline-flex; justify-content: center; align-items: center;" onclick="removerBloco('${uniqueId}')" title="Remover Bloco">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
        `;
        container.insertAdjacentHTML('beforeend', html);
    }

    function adicionarBlocoImagem(containerId) {
        const container = document.getElementById(containerId);
        const uniqueId = gerarIdUnico(); // Gera um índice seguro e exclusivo

        const html = `
        <div class="card mb-3 border-left-success shadow-sm bloco-dinamico" id="bloco_${uniqueId}">
            <div class="card-body py-2">
                <div class="row align-items-center">
                    <div class="col-md-1 text-center">
                        <i class="fas fa-grip-lines text-muted handle" style="cursor: grab; font-size: 1.5rem;" title="Arraste para reordenar"></i>
                    </div>
                    <div class="col-md-2">
                        <label class="text-xs font-weight-bold text-uppercase mb-1 text-success">Imagem</label>
                        <input type="hidden" name="textos[${uniqueId}][tipo]" value="imagem">
                        <div class="h5 mt-1"><span class="badge badge-success w-100 py-2">IMAGEM</span></div>
                    </div>
                    <div class="col-md-8">
                        <label class="text-xs font-weight-bold text-uppercase mb-1">Selecione o Arquivo</label>
                        <input type="file" name="textos[${uniqueId}][conteudo_imagem]" class="form-control-file p-2 border rounded" accept="image/*" required>
                    </div>
                    <div class="col-md-1 d-flex justify-content-center align-items-center mt-3">
                        <button type="button" class="btn btn-danger rounded-circle shadow" style="width: 36px; height: 36px; padding: 0; display: inline-flex; justify-content: center; align-items: center;" onclick="removerBloco('${uniqueId}')" title="Remover Bloco">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
        `;
        container.insertAdjacentHTML('beforeend', html);
    }

    function removerBloco(id) {
        const bloco = document.getElementById(`bloco_${id}`);
        if (bloco) {
            bloco.style.opacity = '0';
            setTimeout(() => bloco.remove(), 200);
        }
    }
</script>
@endsection
